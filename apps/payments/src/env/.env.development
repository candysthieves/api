# HTTP Server
PORT=3004

# Microservice TCP Transport (Optional)
TCP_HOST="127.0.0.1"
TCP_PORT=3005

# ClickHouse Database Connection (Default docker-compose credentials)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=payments

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend
FRONTEND_URL=http://localhost:3000


RABBITMQ_URL=amqp://rabbit:rabbit@localhost:5672
RABBITMQ_PREFETCH_COUNT=20
RABBITMQ_FILES_TO_MAIN_QUEUE=lumos.development.files-to-main
SUBSCRIPTION_DURATION_MINUTES=1
