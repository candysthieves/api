# HTTP Server
PORT=3004

# Microservice TCP Transport (Optional)
TCP_HOST="127.0.0.1"
TCP_PORT=3005

# ClickHouse Database Connection (Default docker-compose credentials)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=payments

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend
FRONTEND_URL=http://localhost:3000

RABBITMQ_MAIN_TO_PAYMENTS_QUEUE="main-to-payments"
RABBITMQ_PAYMENTS_TO_MAIN_QUEUE="payments-to-main"
RABBITMQ_URL="amqp://localhost:5672"
