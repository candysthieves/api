# Порт HTTP-сервера API в тестовом окружении.
PORT=3001
# Строка подключения к тестовой базе данных PostgreSQL.
DATABASE_URL=
# Секрет для подписи access JWT в тестах.
JWT_SECRET_KEY=testing-access-secret-not-for-production
# Секрет для подписи refresh JWT в тестах.
JWT_SECRET_REFRESH_KEY=testing-refresh-secret-not-for-production
# Время жизни access JWT.
JWT_EXPIRES_IN=15m
# Время жизни refresh JWT.
JWT_REFRESH_EXPIRES_IN=7d

# Время жизни кода подтверждения email.
EMAIL_CONFIRMATION_EXPIRES_IN=30m
# Время жизни кода восстановления пароля.
PASSWORD_RECOVERY_EXPIRES_IN=1h
# Логин SMTP-аккаунта для тестовой отправки писем.
SMTP_USER=your@email.com
# Пароль или app password SMTP-аккаунта.
SMTP_PASSWORD=your_app_password
# Тестовый секрет reCAPTCHA: реальные запросы Google в unit-тестах не выполняются.
RECAPTCHA_SECRET_KEY=testing-recaptcha-secret-not-for-production
# Минимальный score reCAPTCHA от 0 до 1.
RECAPTCHA_MIN_SCORE=0.5
# Допустимые hostname через запятую, без схемы, порта и пути.
RECAPTCHA_ALLOWED_HOSTNAMES=localhost

