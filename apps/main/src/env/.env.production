# Порт HTTP-сервера API.
#PORT=3001

# Строка подключения к production-базе данных PostgreSQL.
#DATABASE_URL=

# Секрет для подписи access JWT.
#JWT_SECRET_KEY=
# Секрет для подписи refresh JWT.
#JWT_SECRET_REFRESH_KEY=
# Время жизни access JWT, например 15m.
#JWT_EXPIRES_IN=
# Время жизни refresh JWT, например 7d.
#JWT_REFRESH_EXPIRES_IN=

# Время жизни кода подтверждения email.
EMAIL_CONFIRMATION_EXPIRES_IN=30m
# Время жизни кода восстановления пароля.
PASSWORD_RECOVERY_EXPIRES_IN=1h

# Логин SMTP-аккаунта для отправки писем.
#SMTP_USER=
# Пароль или app password SMTP-аккаунта.
#SMTP_PASSWORD=

# reCAPTCHA v2 Checkbox server secret. Kubernetes overrides this template value from its Secret.
#RECAPTCHA_SECRET_KEY=
# Допустимые hostname через запятую, без схемы, порта и пути.
#RECAPTCHA_ALLOWED_HOSTNAMES=