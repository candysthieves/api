
# Порт HTTP-сервера API в окружении разработки.
PORT=9997

# Строка подключения к development-базе данных PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public
# Секрет для подписи access JWT; не использовать в production.
JWT_SECRET_KEY=development-access-secret-not-for-production
# Секрет для подписи refresh JWT; не использовать в production.
JWT_SECRET_REFRESH_KEY=development-refresh-secret-not-for-production
# Время жизни access JWT.
JWT_EXPIRES_IN=15m
# Время жизни refresh JWT.
JWT_REFRESH_EXPIRES_IN=7d

# Время жизни кода подтверждения email.
EMAIL_CONFIRMATION_EXPIRES_IN=30m
# Время жизни кода восстановления пароля.
PASSWORD_RECOVERY_EXPIRES_IN=1h

# Логин SMTP-аккаунта для отправки писем.
SMTP_USER=your@email.com
# Пароль или app password SMTP-аккаунта.
SMTP_PASSWORD=your_app_password
# Секретный ключ reCAPTCHA v3 из Google Console. Не публикуйте его в клиентском приложении.
RECAPTCHA_SECRET_KEY=replace-with-development-recaptcha-secret
# Минимальный score reCAPTCHA от 0 до 1. При 0.5 токены с меньшим score отклоняются.
RECAPTCHA_MIN_SCORE=0.5
# Допустимые hostname через запятую, без схемы, порта и пути.
RECAPTCHA_ALLOWED_HOSTNAMES=localhost

