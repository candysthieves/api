generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  google
  github
}

enum EventStatus {
  UNPROCESSED
  PROCESSING
  OK
  ERROR
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  username  String  @unique
  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  isEmailConfirmed          Boolean   @default(false) @map("is_email_confirmed")
  confirmationCode          String?   @unique @map("confirmation_code")
  confirmationExpiresAt     DateTime  @map("confirmation_expires_at")
  passwordRecoveryCode      String?   @unique @map("password_recovery_code")
  passwordRecoveryExpiresAt DateTime? @map("password_recovery_expires_at")
  termsAcceptedAt           DateTime  @default(now()) @map("terms_accepted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  oauthAccounts OAuthAccount[]
  posts         Post[]
  sessions      Session[]
}

model OAuthAccount {
  id         String        @id @default(uuid())
  provider   OAuthProvider
  providerId String        @map("provider_id")
  email      String
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([providerId, provider])
  @@index([userId])
}

model Post {
  id            String      @id @default(uuid()) @db.Uuid
  description   String
  /// [PostLocations]
  locations     Json        @default("[]") @db.JsonB
  /// [PostImages]
  images        Json        @default("[]") @db.JsonB
  /// [PostPreview]
  preview       Json?       @db.JsonB
  mediaStatus   MediaStatus @default(PROCESSING) @map("media_status")
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  willBeDeleted DateTime?   @map("will_be_deleted")

  @@index([userId])
  @@index([willBeDeleted])
}

model OutputEvent {
  eventId             String      @id @map("event_id") @db.Uuid
  consumer            String?
  type                String?
  /// [Prisma.JsonValue]
  data                Json?       @db.JsonB
  body                Bytes?      @db.ByteA
  status              EventStatus @default(UNPROCESSED)
  attempts            Int?        @default(0)
  processingStartedAt DateTime?   @map("processing_started_at")
  nextAttemptAt       DateTime?   @map("next_attempt_at")
  completedAt         DateTime?   @map("completed_at")
  lastError           String?     @map("last_error")
  createdAt           DateTime?   @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([status, processingStartedAt])
  @@index([status, completedAt])
}

model InboxEvent {
  eventId             String      @id @map("event_id") @db.Uuid
  consumer            String?
  type                String?
  /// [Prisma.JsonValue]
  data                Json?       @db.JsonB
  body                Bytes?      @db.ByteA
  status              EventStatus @default(UNPROCESSED)
  attempts            Int?        @default(0)
  processingStartedAt DateTime?   @map("processing_started_at")
  nextAttemptAt       DateTime?   @map("next_attempt_at")
  completedAt         DateTime?   @map("completed_at")
  lastError           String?     @map("last_error")
  createdAt           DateTime?   @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([status, processingStartedAt])
  @@index([status, completedAt])
  @@map("InputEvent")
}

model Session {
  id String @id @default(uuid())

  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String    @map("device_name")
  ip         String
  issuedAt   DateTime  @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
}
